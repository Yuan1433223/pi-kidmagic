# Kidmagic 生产环境变量模板
# 复制为 .env.production 并填写真实值后用于 docker compose --env-file
# 不要提交真实 key。生产建议强随机 secret：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ── 必填（缺失会导致容器启动失败）──
PG_PASSWORD=请填写强密码
KIDMAGIC_JWT_SECRET=请填写强随机32字节hex

# ── 模型（通义千问，chat 与图生图共用 key）──
QWEN_MODEL=qwen3.7-plus
QWEN_BASE_URL=https://llm-8u9bxxoc5d2pfvq0.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
QWEN_TOKEN_PLAN_CN_API_KEY=请填写
KIDMAGIC_PERSONA=A

# ── 部署 ──
KIDMAGIC_ENV=production
KIDMAGIC_CORS_ORIGIN=https://你的域名
PORT=8787

# ── 语音（当前 TTS 音色待调通，先保留空/占位；调通后填入）──
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TTS_ACCESS_KEY=
TTS_APP_ID=
TTS_RESOURCE_ID=seed-tts-2.0
TTS_SPEAKER=zh_female_vv_uranus_bigtts
