{
	"name": "@earendil-works/pi-kidmagic",
	"version": "0.1.0",
	"description": "Kidmagic - 儿童创造力故事机（基于 Pi 二开的独立产品包）",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsgo -p tsconfig.build.json",
		"test": "vitest --run",
		"demo": "node --experimental-strip-types scripts/demo-script.ts",
		"check": "tsgo -p tsconfig.json --noEmit"
	},
	"dependencies": {
		"@earendil-works/pi-agent-core": "^0.87.0",
		"@earendil-works/pi-ai": "^0.87.0",
		"@earendil-works/pi-session-backend-sqlite-node": "^0.87.0",
		"typebox": "1.3.27"
	},
	"devDependencies": {
		"@types/node": "22.19.19",
		"shx": "0.4.0",
		"typescript": "5.9.3",
		"vitest": "4.1.9"
	},
	"keywords": [
		"ai",
		"agent",
		"children",
		"creativity",
		"storytelling"
	],
	"license": "MIT",
	"engines": {
		"node": ">=22.19.0"
	}
}
