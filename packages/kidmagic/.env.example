# ── 模型 key 配置模板 ─────────────────────────────────────────────
# 用法：复制本文件为 .env（同目录），填入真实值。.env 已被 .gitignore 忽略，不会进版本库。
#   PowerShell:  Copy-Item .env.example .env

# ── 方式 1：阿里云百炼「专属实例」（端点形如 llm-<实例id>.cn-beijing.maas.aliyuncs.com）──
# 在百炼控制台「专属实例 / 实例详情」里复制完整 OpenAI 兼容端点（含 /compatible-mode/v1）
QWEN_BASE_URL=https://llm-xxxxxxxx.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# key 三选一填即可（官方示例常用 DASHSCOPE_API_KEY，本项目也认）
QWEN_API_KEY=
# DASHSCOPE_API_KEY=
# 专属实例默认模型 qwen3.8-max
QWEN_MODEL=qwen3.8-max

# ── 方式 2：阿里云百炼「Token Plan 公共套餐网关」（无专属实例时用这个）──────────
# QWEN_TOKEN_PLAN_CN_API_KEY=
# QWEN_MODEL=qwen3.8-flash

# ── 方式 3：OpenRouter（备选；多种都存在时默认优先：专属实例 > 公共套餐 > OpenRouter）──
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemini-2.5-flash
# 强制走 OpenRouter 时设：KIDMAGIC_PROVIDER=openrouter

# 可选：人设 A=琪琪老师（默认） / B=动画伙伴
KIDMAGIC_PERSONA=A

# ── 存储与队列（P0-1 / P0-2）──────────────────────────────────────
# PostgreSQL 作品库（默认连本地 kidmagic 库；密码按本地安装改）
DATABASE_URL=postgres://postgres:123456@localhost:5432/kidmagic
# Redis（图生图异步队列 BullMQ）。本地用 Memurai 提供 Redis 兼容服务，默认 6379
REDIS_HOST=localhost
REDIS_PORT=6379
# 图生图（通义万相 qwen-image-3.0；不设 key 时绘本只排版文字）
QWEN_IMAGE_MODEL=qwen-image-3.0
QWEN_IMAGE_SIZE=1024*1024
# 强制禁用图生图（整章纯文字）：KIDMAGIC_IMAGE_DISABLED=1

# ── 账号（P0-3）──────────────────────────────────────────────────
# 家长账号 JWT 签名密钥。本地 demo 不设则用内置 dev 密钥并打警告；上线前必须配置随机串
#   PowerShell 生成： python -c "import secrets;print(secrets.token_hex(32))"
# KIDMAGIC_JWT_SECRET=

# ── 语音（P0-4）──────────────────────────────────────────────────
# 腾讯云 ASR（一句话识别，孩子开口讲 → 文本；不配则 /api/voice/recognize 返回 501）
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_ASR_REGION=ap-beijing
TENCENT_ASR_ENGINE=16k_zh
# ASR 轮询参数（可选，默认 600s / 3s）
ASR_MAX_WAIT_SECONDS=600
ASR_POLL_INTERVAL_SECONDS=3
# 火山引擎 TTS（琪琪老师开口回应 → mp3；不配则 /api/voice/tts 返回 501）
TTS_URL=https://openspeech.bytedance.com/api/v3/tts/unidirectional/sse
TTS_APP_ID=
TTS_ACCESS_KEY=
TTS_RESOURCE_ID=seed-tts-2.0
TTS_SPEAKER=zh_female_cancan_uranus_bigtts
TTS_UID=local-user

# ── 生产（P0-5）──────────────────────────────────────────────────
# 部署到云上时置 production：未设 KIDMAGIC_JWT_SECRET 会拒绝启动
# KIDMAGIC_ENV=production
# CORS 收紧：默认放开（*）；部署时设为你的前端域名
# KIDMAGIC_CORS_ORIGIN=https://你的域名
# 管理员后台（P0-6）：配置后 /admin 页面 + /api/admin/* 才启用
#   PowerShell 生成： python -c "import secrets;print(secrets.token_urlsafe(16))"
# KIDMAGIC_ADMIN_PASSWORD=

# ── 对象存储（预留；当前上传走本地 uploads/，OSS 迁移后置）────────
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# OSS_ENDPOINT=oss-cn-shenzhen.aliyuncs.com
# OSS_BUCKET_NAME=kidmagic-dev-asset
# OSS_PUBLIC_DOMAIN=

